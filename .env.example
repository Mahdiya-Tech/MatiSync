# MatiSync Environment Configuration

# Database: SQLite for local, PostgreSQL for production
# Local SQLite default: sqlite:///./data/matisync.db
# Render PostgreSQL example: postgresql://matisync_user:password@dpg-xxxx.render.com/matisync
DATABASE_URL=sqlite:///./data/matisync.db

# JWT & API Security
SECRET_KEY=your-secret-key-here
DEPLOYMENT_MODE=pilot

# Active Sector Rules: oil_and_gas | power | steel | mining | heavy_engineering
ACTIVE_SECTOR=oil_and_gas

# Frontend API URL (for production build)
VITE_API_URL=http://localhost:8000
